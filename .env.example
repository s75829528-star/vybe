# ---------------------------------------------------------------------------
# VYBE client configuration
# Copy this file to `.env` and fill in the values from your Supabase project.
# Only EXPO_PUBLIC_* variables are embedded in the Android bundle.
# NEVER put a service-role key or a Cloudinary API secret in this file.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: shown in Settings > App information as the media CDN.
# Uploads are signed by the Cloudinary Edge Function, so no Cloudinary secret
# is ever required by the Android app.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Supabase Edge Function secrets (set with `supabase secrets set`; do not add
# secret values to this client .env):
#   CLOUDINARY_CLOUD_NAME
#   CLOUDINARY_API_KEY
#   CLOUDINARY_API_SECRET
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY to deployed Edge Functions automatically.
# Optional function restriction: ALLOWED_ORIGIN
